# ==========================================
# DBU Connect — Environment Configuration Template
# ==========================================
# Copy this file to .env before starting the application:
#   cp .env.example .env

# Node Environment
NODE_ENV=development
PORT=3000

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database Connection URL
# Local Development default (SQLite): file:./dev.db
# For production PostgreSQL: postgresql://username:password@localhost:5432/dbu_connect?schema=public
DATABASE_URL="file:./dev.db"

# Session & JWT Secret Key (Generate a random 32+ character string for production)
SESSION_SECRET="dbu-connect-dev-super-secret-key-32-chars-min"

# University Institutional Domain Configuration
ALLOWED_EMAIL_DOMAIN="@dbu.edu.et"

# Menilik AI Configuration
# Optional: Set an OpenAI or Gemini API key if using live cloud models.
# If omitted, Menilik operates using grounded local keyword-semantic retrieval and university policy handbook passages.
MENILIK_AI_API_KEY=""
MENILIK_AI_PROVIDER="local-rag" # "local-rag" | "openai" | "gemini"

# Email / Notification Provider (Optional for live delivery)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@dbu.edu.et"
